# ============================================================
#  APRENDO LMS — Variables de entorno
#  Copia este archivo a  .env  y rellena tus credenciales,
#  o ejecuta:  pwsh _tools/set-credentials.ps1
#  NUNCA subas .env a GitHub (ya está en .gitignore)
# ============================================================

# ---------- SUPABASE (backend: auth + progreso + cursos) ----------
# Dónde: Supabase Dashboard > Project Settings > Data API  (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Dónde: Supabase Dashboard > Project Settings > API Keys > anon / publishable
# Esta clave ES PÚBLICA por diseño: va en el frontend y queda protegida por RLS.
SUPABASE_ANON_KEY=

# OPCIONAL y SECRETO — solo para scripts de administración locales.
# NUNCA lo pongas en el frontend ni en GitHub Pages.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WISTIA (almacenamiento de video) ----------
# El reproductor (Player API, percentwatchedchanged) NO necesita token.
# El token solo sirve para GESTIONAR la videoteca (subir, listar, borrar).
# Dónde: wistia.com > Account > Settings > API Access > New Token
WISTIA_API_TOKEN=

# Proyecto/hashtag de Wistia donde vivirán los videos (opcional)
WISTIA_PROJECT_ID=

# ---------- GITHUB (repositorio + GitHub Pages) ----------
# Dónde: github.com > Settings > Developer settings > Personal access tokens
# Permisos necesarios: repo (Contents: Read and write) + workflow si usas Actions
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_BRANCH=main

# ---------- CLOUDFLARE (dominio + CDN) ----------
# Dónde: dash.cloudflare.com > My Profile > API Tokens
# Permisos: Zone > DNS > Edit  y  Zone > Zone > Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ---------- AJUSTES DE LA PLATAFORMA ----------
# Nombre de tu academia: aparece en el certificado (configurable en admin)
ACADEMY_NAME=
# Dominio raíz al que se colgarán los subdominios de cada curso
ROOT_DOMAIN=
