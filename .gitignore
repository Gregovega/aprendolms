# ===== SECRETOS: nunca subir =====
.env
.env.local
.env.*.local
*.pem
*.key

# ===== Credenciales y reportes locales =====
_tools/.credentials-backup/
_tools/*.log
acl-report-*.jsonl
acl-backup-*.json

# ===== Node =====
node_modules/
npm-debug.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# ===== Build / temporales =====
dist/
build/
.cache/
*.tmp
~$*

# ===== Sistema operativo =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== Editores =====
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ===== NO ignorar (el frontend SÍ necesita su config pública) =====
!assets/js/config.js
!config/supabase.config.js

# ===== Dependencias solo para las pruebas locales =====
# jsPDF y sus dependencias, instaladas con npm para poder ejecutar
# _tools/test-certificado.js. No hace falta en el sitio publicado: el navegador
# carga jsPDF desde su CDN. Se reinstala con:
#   cd _tools\vendor && npm install jspdf@2.5.2 --no-audit --no-fund
_tools/vendor/
_tools/certificado-de-prueba.pdf
# ---- Archivos de prueba que crea el navegador al verificar el aspecto visual.
# Nunca deben publicarse: son capturas de pantalla y arneses temporales.
_tools/captura-*.png
_tools/_*.html
_tools/prueba-*.html
